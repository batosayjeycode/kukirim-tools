---
/** "Panduan terkait": links from a tool/template page to its companion guides on kukirim.com (PAGES[].guides). */
import { PAGES } from '../config.js';

interface Props {
  path: string;
}

const guides = PAGES.find((p) => p.path === Astro.props.path)?.guides ?? [];
---

{
  guides.length > 0 && (
    <>
      <h2>Panduan terkait</h2>
      <ul>
        {guides.map((g) => (
          <li>
            <a href={g.url}>{g.title}</a>
          </li>
        ))}
      </ul>
    </>
  )
}
